Vagrant.configure("2") do |config|
    config.hostmanager.enabled = true
    config.hostmanaer.manage_host = true

### VM Configuration ###

## DB VM ##
config.define "db01" do |db01|
    db01.vm.box = "generic/centos9s"
    db01.vm.hostname = "db01"
    db01.vm.network "private_network", ip: "192.168.2.14"
    db01.vm.provider "virtual_box" do |vb|
        vb.memory = "256"
    end
end

## Memcache VM ##
config.define "mc01" do |mc01|
    mc01.vm.box = "generic/centos9s"
    mc01.vm.hostname = "mc01"
    mc01.vm.network "private_network", ip: "192.168.2.15"
    mc01.vm.provider "virtual_box" do |vb|
        vb.memory = "256"
    end
end

